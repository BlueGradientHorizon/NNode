CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
# -Os instead of the IDF default -Og: ~100 KB smaller firmware, verified
# on ESP32-C3 (same sources, no behavior change).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LWIP_STATS=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV4_NAPT_PORTMAP=y
CONFIG_ESP_SYSTEM_MEMPROT=n
# ELF loader must look for modules where NNode keeps them: LittleFS /data
# (its default is /storage, which does not exist here -> "open failed").
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=y
CONFIG_ELF_FILE_SYSTEM_BASE_PATH="/data"
# Newlib, not the v6 default PicolibC: ELF modules and the modsym table
# rely on Newlib internals (__getreent), and the pinned elf_loader fork
# includes <reent.h>. Compatibility matters more than the size saving.
CONFIG_LIBC_NEWLIB=y
# A/B firmware updates (ota_0/ota_1): if the new slot crashes before
# the app marks itself valid, the bootloader falls back to the old slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
